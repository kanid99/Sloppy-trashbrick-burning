<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Only loaded when Dubs Bad Hygiene is active. -->
	<ThingDef ParentName="ResourceBase">
		<defName>STB_SludgePellets</defName>
		<label>sludge pellets</label>
		<description>Fecal sludge that has been dried, pressed and baked into hard fuel pellets for a pellet stove. Pellets give less energy than refining the sludge into chemfuel, but they don't explode when damaged, burn slowly, and don't rot.</description>
		<graphicData>
			<!-- Reuses the vanilla kibble texture, tinted brown. -->
			<texPath>Things/Item/Resource/Kibble</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
			<color>(110,80,50)</color>
		</graphicData>
		<soundInteract>Stone_Drop</soundInteract>
		<soundDrop>Stone_Drop</soundDrop>
		<useHitPoints>true</useHitPoints>
		<healthAffectsPrice>false</healthAffectsPrice>
		<tradeability>None</tradeability>
		<stackLimit>150</stackLimit>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<MarketValue>0.2</MarketValue>
			<Mass>0.03</Mass>
			<Flammability>0.4</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<Beauty>-10</Beauty>
		</statBases>
		<thingCategories>
			<li>Manufactured</li>
		</thingCategories>
	</ThingDef>

	<!--
		Chemfuel route (DBH): 75 sludge -> 35 chemfuel, about 7.8 days of a chemfuel generator.
		Pellet route: 75 sludge -> 100 pellets, 5 days of a pellet stove. You give up some energy for fuel that is safe to store.
	-->
	<RecipeDef>
		<defName>STB_Make_SludgePellets</defName>
		<label>make sludge pellets</label>
		<description>Dry and press fecal sludge into stable fuel pellets for a pellet stove.</description>
		<jobString>Pressing sludge pellets.</jobString>
		<effectWorking>Cremate</effectWorking>
		<soundWorking>Recipe_Cremate</soundWorking>
		<workAmount>2500</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>FecalSludge</li>
					</thingDefs>
				</filter>
				<count>75</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>FecalSludge</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<STB_SludgePellets>100</STB_SludgePellets>
		</products>
		<recipeUsers>
			<li>BiofuelRefinery</li>
		</recipeUsers>
	</RecipeDef>

</Defs>
