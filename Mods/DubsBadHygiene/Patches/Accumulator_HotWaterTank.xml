<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		The Overpressure Tank doubles as a DBH boiler: plumbing connects it to DBH's pipes, and
		CompTankBoiler feeds DBH's hot water tanks and radiators from the heat it holds, which draws
		its pressure down.
	-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="STB_HeatAccumulator"]/comps</xpath>
		<value>
			<li Class="DubsBadHygiene.CompProperties_Pipe">
				<mode>Sewage</mode>
			</li>
			<li Class="DubsBadHygiene.CompProperties_CompBoiler">
				<compClass>TrashbrickBurning.DBH.CompTankBoiler</compClass>
				<BaseCapacity>3000</BaseCapacity>
				<ThermostatControl>false</ThermostatControl>
			</li>
		</value>
	</Operation>

</Patch>
