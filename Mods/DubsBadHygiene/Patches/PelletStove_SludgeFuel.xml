<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Let both stoves burn sludge pellets as well as trashbricks. -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="STB_TrashbrickPelletStove" or defName="STB_TrashbrickGasifier"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs</xpath>
		<value>
			<li>STB_SludgePellets</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="STB_TrashbrickPelletStove" or defName="STB_TrashbrickGasifier"]/comps/li[@Class="CompProperties_Refuelable"]/fuelLabel</xpath>
		<value>
			<fuelLabel>Pellet fuel</fuelLabel>
		</value>
	</Operation>

	<!-- Let the fuel hopper hold sludge pellets too. -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="STB_FuelHopper"]/building/fixedStorageSettings/filter/thingDefs</xpath>
		<value>
			<li>STB_SludgePellets</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="STB_FuelHopper"]/building/defaultStorageSettings/filter/thingDefs</xpath>
		<value>
			<li>STB_SludgePellets</li>
		</value>
	</Operation>

</Patch>
