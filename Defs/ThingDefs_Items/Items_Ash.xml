<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- What the burners leave behind. Put out behind each burner as it builds up (see Ash.cs). -->
	<ThingDef ParentName="ResourceBase">
		<defName>STB_Ash</defName>
		<label>ash</label>
		<description>Fine grey ash raked from a trashbrick burner. On its own it's only good for making ashcrete blocks at a stonecutter's table.</description>
		<graphicData>
			<texPath>Things/Item/Resource/STB_Ash</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<soundInteract>Silver_Drop</soundInteract>
		<soundDrop>Silver_Drop</soundDrop>
		<useHitPoints>false</useHitPoints>
		<stackLimit>75</stackLimit>
		<statBases>
			<MarketValue>0.1</MarketValue>
			<Mass>0.05</Mass>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<Beauty>-4</Beauty>
		</statBases>
		<thingCategories>
			<li>ResourcesRaw</li>
		</thingCategories>
		<tradeability>None</tradeability>
	</ThingDef>

	<!--
		Ashcrete blocks: ash bound into a cheap, fireproof block. Weaker and uglier than stone blocks,
		quicker to build with, and it can't burn. Stuff like any stone block.
	-->
	<ThingDef ParentName="ResourceBase">
		<defName>STB_AshcreteBlocks</defName>
		<label>ashcrete blocks</label>
		<description>Blocks of burner ash bound with a little lime and pressed. Cheap, grey and completely fireproof, but crumblier than cut stone.</description>
		<graphicData>
			<texPath>Things/Item/Resource/STB_AshcreteBlocks</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<soundInteract>Stone_Drop</soundInteract>
		<soundDrop>Stone_Drop</soundDrop>
		<useHitPoints>true</useHitPoints>
		<stackLimit>75</stackLimit>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<MarketValue>0.6</MarketValue>
			<Mass>0.7</Mass>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<SharpDamageMultiplier>0.6</SharpDamageMultiplier>
			<BluntDamageMultiplier>1.0</BluntDamageMultiplier>
			<Beauty>-4</Beauty>
		</statBases>
		<thingCategories>
			<li>StoneBlocks</li>
		</thingCategories>
		<stuffProps>
			<categories>
				<li>Stony</li>
			</categories>
			<commonality>0</commonality>
			<appearance>Bricks</appearance>
			<color>(128,126,122)</color>
			<constructEffect>ConstructDirt</constructEffect>
			<soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
			<soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
			<soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
			<stuffAdjective>ashcrete</stuffAdjective>
			<statOffsets>
				<WorkToBuild>70</WorkToBuild>
			</statOffsets>
			<statFactors>
				<MarketValue>0.4</MarketValue>
				<MaxHitPoints>0.8</MaxHitPoints>
				<Beauty>0.6</Beauty>
				<Flammability>0</Flammability>
				<WorkToBuild>0.8</WorkToBuild>
				<WorkToMake>1.1</WorkToMake>
				<DoorOpenSpeed>0.45</DoorOpenSpeed>
				<BedRestEffectiveness>0.9</BedRestEffectiveness>
				<MeleeWeapon_CooldownMultiplier>1.3</MeleeWeapon_CooldownMultiplier>
			</statFactors>
			<canSuggestUseDefaultStuff>false</canSuggestUseDefaultStuff>
			<allowedInStuffGeneration>false</allowedInStuffGeneration>
		</stuffProps>
	</ThingDef>

</Defs>
