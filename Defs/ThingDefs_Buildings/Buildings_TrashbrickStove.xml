<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Modelled on the vanilla wood-fired generator, fuelled by trashbricks from Vanilla Recycling Expanded. -->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_TrashbrickPelletStove</defName>
		<label>cobbled trash gasifier</label>
		<description>A trash gasifier cobbled together from scrap plate and a salvaged Stirling engine, burning compressed trashbricks. It has three modes: eco gets the most heat from each brick, high the most heat. With no steam turbine on its pressurised hot water network, its Stirling engine makes a little power (75-300W) from three times that in heat; the rest of its heat goes out on the pipe, so it still needs an Overpressure Tank or radiators, or its pressure builds - and with no safety valve, it bursts. It breaks down often. Refill it by hand, or put a hopper on its intake - the green-marked port on the side it faces - and it will draw fuel from that. It heats the room while it runs. Its exhaust must be piped to an exhaust port, or it fills the room around it with toxic gas.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_CobbledPelletStove</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<!-- Drawn a margin larger than its 2x2 footprint so raised parts aren't clipped. -->
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<!-- RealTime as well, so CompLooseParts can draw and shake the loose parts every frame. -->
		<drawerType>MapMeshAndRealTime</drawerType>
		<passability>PassThroughOnly</passability>
		<pathCost>150</pathCost>
		<blockWind>true</blockWind>
		<fillPercent>1.0</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<size>(2,2)</size>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToBuild>2800</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>-30</Beauty>
		</statBases>
		<costList>
			<Steel>120</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>TrashbrickBurning.CompPowerPlantStirling</compClass>
				<basePowerConsumption>-1000</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
				<soundAmbientProducingPower>WoodFiredGenerator_Ambience</soundAmbientProducingPower>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Refuelable">
				<!-- Trashbricks per day at full burn. One garbage compactor makes 25 a day. -->
				<fuelConsumptionRate>20.0</fuelConsumptionRate>
				<fuelCapacity>150.0</fuelCapacity>
				<fuelLabel>Trashbricks</fuelLabel>
				<fuelFilter>
					<thingDefs>
						<li>VRecyclingE_TrashBrick</li>
						<!-- Other fuels, at their own values (CompStirlingEngine.otherFuels). Removed at
						     startup if the setting is off. -->
						<li>WoodLog</li>
						<li>Chemfuel</li>
						<li>Hay</li>
						<li>Cloth</li>
						<li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
						<!-- Dirty fuels: always allowed. They burn with more toxic gas and less ground
						     pollution than trashbricks, so burning cleaned-up pollution can't loop. -->
						<li>VRecyclingE_Trash</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Wastepack</li>
					</thingDefs>
				</fuelFilter>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
				<!-- CompStirlingEngine burns the fuel, at a rate that depends on the play mode and burn rate. -->
				<externalTicking>true</externalTicking>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>6</glowRadius>
				<glowColor>(217,112,33,0)</glowColor>
			</li>
			<li Class="CompProperties_Breakdownable"/>
			<!-- Cobbled gear breaks down twice as often as vanilla machines. -->
			<li Class="TrashbrickBurning.CompProperties_ExtraBreakdowns"/>
			<!-- Pulls fuel from any adjacent hopper (ours, vanilla, or VFE Factory's). -->
			<li Class="TrashbrickBurning.CompProperties_HopperFeed"/>
			<!--
				The firebox and engine: burns the fuel (so the refuelable is externally ticked), heats
				the room, and sets the power output. Simple play mode uses the simple* values and the
				power comp's output. Advanced play mode makes it a burner at one of these heat levels:
				hotter burns cost more fuel per watt and waste more heat into the room. Its heat goes to
				steam turbines first; with no turbine on the network, the Stirling engine makes stirlingWatts
				from three times that in heat, and the rest still goes out on the pipe.
			-->
			<li Class="TrashbrickBurning.CompProperties_StirlingEngine">
				<simpleFuelPerDay>20</simpleFuelPerDay>
				<simpleRoomHeatPerSecond>8</simpleRoomHeatPerSecond>
				<cooledPowerFactor>1.2</cooledPowerFactor>
				<heatRecoveryPowerFactor>0.5</heatRecoveryPowerFactor>
				<heatLevels>
					<li><key>Eco</key><watts>600</watts><fuelPerDay>40</fuelPerDay><roomHeatPerSecond>5</roomHeatPerSecond><stirlingWatts>75</stirlingWatts><waterPerDay>16</waterPerDay></li>
					<li><key>Normal</key><watts>1200</watts><fuelPerDay>100</fuelPerDay><roomHeatPerSecond>10</roomHeatPerSecond><stirlingWatts>150</stirlingWatts><waterPerDay>32</waterPerDay></li>
					<li><key>High</key><watts>1600</watts><fuelPerDay>150</fuelPerDay><roomHeatPerSecond>14</roomHeatPerSecond><stirlingWatts>300</stirlingWatts><waterPerDay>43</waterPerDay></li>
				</heatLevels>
				<!-- Jerry-rigged: no working safety valve. At full pressure it bursts. -->
				<safetyValve>false</safetyValve>
				<otherFuels>
					<!-- Wood burns clean: little gas, and ash rather than ground pollution. -->
					<li><thing>WoodLog</thing><value>0.4</value><pollutionFactor>0.3</pollutionFactor><toxGasFactor>0.5</toxGasFactor></li>
					<!-- Chemfuel burns hot and fairly clean in the air, but drips and soaks into the ground. -->
					<li><thing>Chemfuel</thing><value>2.5</value><pollutionFactor>1.5</pollutionFactor><toxGasFactor>0.6</toxGasFactor></li>
					<!-- Refused until allowed on each burner's Fuels menu: fodder, cloth, and Anomaly's bioferrite. -->
					<li><thing>Hay</thing><value>0.15</value><pollutionFactor>0.2</pollutionFactor><toxGasFactor>0.4</toxGasFactor><refusedByDefault>true</refusedByDefault></li>
					<li><thing>Cloth</thing><value>0.25</value><pollutionFactor>0.5</pollutionFactor><toxGasFactor>1.5</toxGasFactor><refusedByDefault>true</refusedByDefault></li>
					<li MayRequire="Ludeon.RimWorld.Anomaly"><thing>Bioferrite</thing><value>4</value><pollutionFactor>1</pollutionFactor><toxGasFactor>2</toxGasFactor><refusedByDefault>true</refusedByDefault></li>
					<!-- 10 trash compacts into 25 bricks; burnt loose it's worth less, and dirtier. -->
					<li><thing>VRecyclingE_Trash</thing><value>1.5</value><pollutionFactor>0.5</pollutionFactor><toxGasFactor>3</toxGasFactor><optional>false</optional></li>
					<!-- About 6 cleaned cells make one wastepack; burning one puts back a sliver of that as
					     ground pollution, and a lot of toxic gas. -->
					<li MayRequire="Ludeon.RimWorld.Biotech"><thing>Wastepack</thing><value>0.5</value><pollutionFactor>0.25</pollutionFactor><toxGasFactor>8</toxGasFactor><optional>false</optional></li>
				</otherFuels>
			</li>
			<!-- Smoke from the flue, a flickering fire window, and the rattle. Points are in the art's
			     own machine coordinates (a across the front, f front to back, z up). -->
			<li Class="TrashbrickBurning.CompProperties_MachineEffects">
				<smoke><a>0.62</a><f>1.62</f><z>0.69</z></smoke>
				<glow><a>1.04</a><f>0.8</f><z>0.43</z></glow>
				<glowSize>1.1</glowSize>
				<sound>STB_RattleAmbience</sound>
			</li>

			<!-- The parts that rattle while it burns: two layers drawn over the sprite and shaken. -->
			<li Class="TrashbrickBurning.CompProperties_LooseParts">
				<layers>
					<li><texPath>Things/Building/Power/STB_CobbledPelletStove_LooseA</texPath><amplitude>0.012</amplitude><frequency>1.9</frequency><phase>0</phase></li>
					<li><texPath>Things/Building/Power/STB_CobbledPelletStove_LooseB</texPath><amplitude>0.009</amplitude><frequency>2.7</frequency><phase>1.3</phase></li>
				</layers>
			</li>
			<!-- Joins the pressurised hot water network when a pipe runs under it. -->
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_HotWaterNet</pipeNet>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
			<!-- Exhaust: piped to an exhaust port, or let out around it as toxic gas. Heat: the exhaust
			     mildly warms wherever it comes out. -->
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_ExhaustNet</pipeNet>
			</li>
			<li Class="TrashbrickBurning.CompProperties_Exhaust">
				<pollutionPerFuel>0.06</pollutionPerFuel>
				<toxGasPerFuel>1000</toxGasPerFuel>
			</li>
		</comps>
		<placeWorkers>
			<li>TrashbrickBurning.PlaceWorker_ShowIntake</li>
		</placeWorkers>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		Tier 2: the same Stirling engine, done properly. The difference is mostly efficiency: twice
		the power per brick (1200W on 12 a day, against 1000W on 20) and a little more output. It
		also doesn't pollute and leaks only a little heat. Costs microelectronics and some plasteel.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_TrashbrickGasifier</defName>
		<label>trash gasifier</label>
		<description>A sealed trash gasifier that bakes trashbricks into syngas and burns it cleanly: 1500W of heat on 75 bricks a day in normal mode, 750W on 30 in eco, 2000W on 112 in high. With no steam turbine on its pressurised hot water network, its Stirling engine makes some power (100-500W) from three times that in heat; the rest goes out on the pipe to an Overpressure Tank or radiators. A safety valve vents any pressure left over. It gets twice the power from each brick that a pellet stove does, and the catalytic filters catch the fumes, so it doesn't pollute. The housing is insulated, so it leaks only a little heat. Refill it by hand, or put a hopper on its intake - the green-marked port on the side it faces - and it will draw fuel from that.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_TrashbrickGasifier</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<!-- Drawn a margin larger than its 2x2 footprint so raised parts aren't clipped. -->
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>150</pathCost>
		<blockWind>true</blockWind>
		<fillPercent>1.0</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<size>(2,2)</size>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<WorkToBuild>5000</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Beauty>-10</Beauty>
		</statBases>
		<costList>
			<Steel>150</Steel>
			<Plasteel>25</Plasteel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>TrashbrickBurning.CompPowerPlantStirling</compClass>
				<basePowerConsumption>-1200</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
				<soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Refuelable">
				<!-- Simple play mode's burn rate: 100W-days per brick against the cobbled stove's 50. -->
				<fuelConsumptionRate>12.0</fuelConsumptionRate>
				<fuelCapacity>150.0</fuelCapacity>
				<fuelLabel>Trashbricks</fuelLabel>
				<fuelFilter>
					<thingDefs>
						<li>VRecyclingE_TrashBrick</li>
						<!-- Other fuels, at their own values (CompStirlingEngine.otherFuels). Removed at
						     startup if the setting is off. -->
						<li>WoodLog</li>
						<li>Chemfuel</li>
						<li>Hay</li>
						<li>Cloth</li>
						<li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
						<!-- Dirty fuels: always allowed. They burn with more toxic gas and less ground
						     pollution than trashbricks, so burning cleaned-up pollution can't loop. -->
						<li>VRecyclingE_Trash</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Wastepack</li>
					</thingDefs>
				</fuelFilter>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
				<!-- CompStirlingEngine burns the fuel, at a rate that depends on the play mode and burn rate. -->
				<externalTicking>true</externalTicking>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>3</glowRadius>
				<glowColor>(70,200,190,0)</glowColor>
			</li>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="TrashbrickBurning.CompProperties_HopperFeed"/>
			<!--
				The firebox and engine: burns the fuel (so the refuelable is externally ticked), heats
				the room, and sets the power output. Simple play mode uses the simple* values and the
				power comp's output. Advanced play mode makes it a burner at one of these heat levels:
				hotter burns cost more fuel per watt and waste more heat into the room. Its heat goes to
				steam turbines first; with no turbine on the network, the Stirling engine makes stirlingWatts
				from three times that in heat, and the rest still goes out on the pipe.
			-->
			<li Class="TrashbrickBurning.CompProperties_StirlingEngine">
				<simpleFuelPerDay>12</simpleFuelPerDay>
				<simpleRoomHeatPerSecond>3</simpleRoomHeatPerSecond>
				<cooledPowerFactor>1.2</cooledPowerFactor>
				<heatRecoveryPowerFactor>0.6</heatRecoveryPowerFactor>
				<heatLevels>
					<li><key>Eco</key><watts>750</watts><fuelPerDay>30</fuelPerDay><roomHeatPerSecond>1.5</roomHeatPerSecond><stirlingWatts>100</stirlingWatts><waterPerDay>20</waterPerDay></li>
					<li><key>Normal</key><watts>1500</watts><fuelPerDay>75</fuelPerDay><roomHeatPerSecond>3</roomHeatPerSecond><stirlingWatts>250</stirlingWatts><waterPerDay>40</waterPerDay></li>
					<li><key>High</key><watts>2000</watts><fuelPerDay>112.5</fuelPerDay><roomHeatPerSecond>4</roomHeatPerSecond><stirlingWatts>500</stirlingWatts><waterPerDay>53</waterPerDay></li>
				</heatLevels>
				<!-- A proper safety valve: vents steam at high pressure instead of bursting. -->
				<safetyValve>true</safetyValve>
				<otherFuels>
					<!-- Wood burns clean: little gas, and ash rather than ground pollution. -->
					<li><thing>WoodLog</thing><value>0.4</value><pollutionFactor>0.3</pollutionFactor><toxGasFactor>0.5</toxGasFactor></li>
					<!-- Chemfuel burns hot and fairly clean in the air, but drips and soaks into the ground. -->
					<li><thing>Chemfuel</thing><value>2.5</value><pollutionFactor>1.5</pollutionFactor><toxGasFactor>0.6</toxGasFactor></li>
					<!-- Refused until allowed on each burner's Fuels menu: fodder, cloth, and Anomaly's bioferrite. -->
					<li><thing>Hay</thing><value>0.15</value><pollutionFactor>0.2</pollutionFactor><toxGasFactor>0.4</toxGasFactor><refusedByDefault>true</refusedByDefault></li>
					<li><thing>Cloth</thing><value>0.25</value><pollutionFactor>0.5</pollutionFactor><toxGasFactor>1.5</toxGasFactor><refusedByDefault>true</refusedByDefault></li>
					<li MayRequire="Ludeon.RimWorld.Anomaly"><thing>Bioferrite</thing><value>4</value><pollutionFactor>1</pollutionFactor><toxGasFactor>2</toxGasFactor><refusedByDefault>true</refusedByDefault></li>
					<!-- 10 trash compacts into 25 bricks; burnt loose it's worth less, and dirtier. -->
					<li><thing>VRecyclingE_Trash</thing><value>1.5</value><pollutionFactor>0.5</pollutionFactor><toxGasFactor>3</toxGasFactor><optional>false</optional></li>
					<!-- About 6 cleaned cells make one wastepack; burning one puts back a sliver of that as
					     ground pollution, and a lot of toxic gas. -->
					<li MayRequire="Ludeon.RimWorld.Biotech"><thing>Wastepack</thing><value>0.5</value><pollutionFactor>0.25</pollutionFactor><toxGasFactor>8</toxGasFactor><optional>false</optional></li>
				</otherFuels>
			</li>
			<!-- Steam wisps from the exhaust stack, where the safety valve vents too. -->
			<li Class="TrashbrickBurning.CompProperties_MachineEffects">
				<steam><a>0.36</a><f>1.7</f><z>0.57</z></steam>
				<smoke><a>0.36</a><f>1.7</f><z>0.6</z></smoke>
				<sound>STB_SteamEngineAmbience</sound>
			</li>

			<!-- Joins the pressurised hot water network when a pipe runs under it. -->
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_HotWaterNet</pipeNet>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
			<!-- Exhaust: piped to an exhaust port, or let out around it as toxic gas. Heat: the exhaust
			     mildly warms wherever it comes out. -->
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_ExhaustNet</pipeNet>
			</li>
			<li Class="TrashbrickBurning.CompProperties_Exhaust">
				<pollutionPerFuel>0.02</pollutionPerFuel>
				<toxGasPerFuel>1200</toxGasPerFuel>
			</li>
		</comps>
		<placeWorkers>
			<li>TrashbrickBurning.PlaceWorker_ShowIntake</li>
		</placeWorkers>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>MicroelectronicsBasics</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		Large tier (3x4): three times the heat of the small burners, a little less fuel per watt.
		At full burn one feeds a steam turbine flat out. Unlike the small burners there's no engine
		on board: all heat, no power, so they need turbines and exist only in advanced play mode.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_LargeCobbledStove</defName>
		<label>large cobbled trash gasifier</label>
		<description>A long firebox welded together from whatever plate was lying around, a scrapped boiler drum, two mismatched flues and a salvaged generator, all on compressed trashbricks. Three times the heat of a cobbled trash gasifier from a little less fuel per watt, and just as short of a safety valve. It has no engine of its own: pipe it to a steam turbine. Refill it by hand, or put a hopper on its intake - the green-marked port on the side it faces - and it will draw fuel from that. It heats the room while it runs. Its exhaust must be piped to an exhaust port, or it fills the room around it with toxic gas.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_LargeCobbledStove</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<!-- Drawn a margin larger than its 3x4 footprint so raised parts aren't clipped. -->
			<drawSize>(4,5)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<!-- RealTime as well, so CompLooseParts can draw and shake the loose parts every frame. -->
		<drawerType>MapMeshAndRealTime</drawerType>
		<passability>PassThroughOnly</passability>
		<pathCost>150</pathCost>
		<blockWind>true</blockWind>
		<fillPercent>1.0</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<size>(3,4)</size>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>700</MaxHitPoints>
			<WorkToBuild>7000</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>-60</Beauty>
		</statBases>
		<costList>
			<Steel>300</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>54.0</fuelConsumptionRate>
				<fuelCapacity>150.0</fuelCapacity>
				<fuelLabel>Trashbricks</fuelLabel>
				<fuelFilter>
					<thingDefs>
						<li>VRecyclingE_TrashBrick</li>
						<!-- Other fuels, at their own values (CompStirlingEngine.otherFuels). Removed at
						     startup if the setting is off. -->
						<li>WoodLog</li>
						<li>Chemfuel</li>
						<li>Hay</li>
						<li>Cloth</li>
						<li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
						<!-- Dirty fuels: always allowed. They burn with more toxic gas and less ground
						     pollution than trashbricks, so burning cleaned-up pollution can't loop. -->
						<li>VRecyclingE_Trash</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Wastepack</li>
					</thingDefs>
				</fuelFilter>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
				<!-- CompStirlingEngine burns the fuel, at a rate that depends on the play mode and burn rate. -->
				<externalTicking>true</externalTicking>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>8</glowRadius>
				<glowColor>(217,112,33,0)</glowColor>
			</li>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="TrashbrickBurning.CompProperties_ExtraBreakdowns"/>
			<!-- Pulls fuel from any adjacent hopper (ours, vanilla, or VFE Factory's). -->
			<li Class="TrashbrickBurning.CompProperties_HopperFeed"/>
			<!--
				The firebox and engine: burns the fuel (so the refuelable is externally ticked), heats
				the room, and sets the power output. Simple play mode uses the simple* values and the
				power comp's output. Advanced play mode makes it a burner at one of these heat levels:
				hotter burns cost more fuel per watt and waste more heat into the room. Its heat goes to
				steam turbines first; with no turbine on the network, the Stirling engine makes stirlingWatts
				from three times that in heat, and the rest still goes out on the pipe.
			-->
			<li Class="TrashbrickBurning.CompProperties_StirlingEngine">
				<!-- No engine of its own: it only makes heat, for steam turbines, so it's advanced mode only. -->
				<simpleFuelPerDay>54</simpleFuelPerDay>
				<simpleRoomHeatPerSecond>22</simpleRoomHeatPerSecond>
				<cooledPowerFactor>1.2</cooledPowerFactor>
				<heatRecoveryPowerFactor>0.5</heatRecoveryPowerFactor>
				<heatLevels>
					<li><key>Eco</key><watts>750</watts><fuelPerDay>22</fuelPerDay><roomHeatPerSecond>12</roomHeatPerSecond><stirlingWatts>0</stirlingWatts><waterPerDay>48</waterPerDay></li>
					<li><key>Normal</key><watts>1000</watts><fuelPerDay>31</fuelPerDay><roomHeatPerSecond>17</roomHeatPerSecond><stirlingWatts>0</stirlingWatts><waterPerDay>96</waterPerDay></li>
					<li><key>High</key><watts>1500</watts><fuelPerDay>54</fuelPerDay><roomHeatPerSecond>30</roomHeatPerSecond><stirlingWatts>0</stirlingWatts><waterPerDay>129</waterPerDay></li>
				</heatLevels>
				<!-- Jerry-rigged: no working safety valve. At full pressure it bursts. -->
				<safetyValve>false</safetyValve>
				<otherFuels>
					<!-- Wood burns clean: little gas, and ash rather than ground pollution. -->
