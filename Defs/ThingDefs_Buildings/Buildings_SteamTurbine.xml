<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Pressurised hot water (advanced play mode): burners send their heat down this network to steam
		turbines, which turn it into power far more efficiently than each burner's own small engine. The network, pipes, overlay and valve are Vanilla Expanded Framework's PipeSystem
		(always present: Vanilla Recycling Expanded requires it). CompSteamTurbine does the sums.
	-->
	<PipeSystem.PipeNetDef>
		<defName>STB_HotWaterNet</defName>
		<resource>
			<name>Pressurised hot water</name>
			<unit>kW</unit>
			<color>(0.80, 0.36, 0.22)</color>
			<onlyShowStored>True</onlyShowStored>
		</resource>
		<pipeDefs>
			<li>STB_HotWaterPipe</li>
			<li>STB_HotWaterPipeHidden</li>
		</pipeDefs>
		<overlayOptions>
			<overlayColor>(0.80, 0.36, 0.22)</overlayColor>
		</overlayOptions>
		<noStorageAlert>true</noStorageAlert>
	</PipeSystem.PipeNetDef>

	<ThingDef Name="STB_HotWaterPipeBase" ParentName="BuildingBase" Abstract="True">
		<thingClass>PipeSystem.Building_Pipe</thingClass>
		<category>Building</category>
		<tickerType>Rare</tickerType>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
			<blueprintGraphicData>
				<texPath>Things/Building/Linked/STB_HotWaterPipe_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
			<canConstructInCorner>true</canConstructInCorner>
		</building>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Conduits</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<drawStyleCategory>Conduits</drawStyleCategory>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_HotWaterNet</pipeNet>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
		</comps>
		<placeWorkers>
			<li>PipeSystem.PlaceWorker_Pipe</li>
		</placeWorkers>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<neverMultiSelect>true</neverMultiSelect>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<!-- Visible and hidden pipe share one architect button. -->
		<designatorDropdown>STB_HotWaterPipes</designatorDropdown>
		<constructEffect>ConstructMetal</constructEffect>
		<clearBuildingArea>false</clearBuildingArea>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="STB_HotWaterPipeBase">
		<defName>STB_HotWaterPipe</defName>
		<label>pressurised hot water pipe</label>
		<description>Lagged, pressure-rated pipe that carries superheated water from trash gasifiers to a steam turbine. Can be placed under walls and other buildings.</description>
		<graphicData>
			<texPath>Things/Building/Linked/STB_HotWaterPipe_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom7</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Linked/STB_HotWaterPipe_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<WorkToBuild>60</WorkToBuild>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<Steel>3</Steel>
		</costList>
		<!-- The base already gives it the network connection; comp lists merge with the parent's,
		     so repeating it here would give the pipe two. -->
		<comps>
			<!-- Springs a steam leak now and then while hot water flows; leaks until repaired. -->
			<li Class="TrashbrickBurning.CompProperties_SteamLeak"/>
		</comps>
	</ThingDef>

	<ThingDef ParentName="STB_HotWaterPipeBase">
		<defName>STB_HotWaterPipeHidden</defName>
		<label>hidden pressurised hot water pipe</label>
		<description>Pressurised hot water pipe buried out of sight. Can be placed under walls and other buildings.</description>
		<graphicData>
			<!-- Vanilla Expanded Framework's own hidden-conduit texture, as VE's hidden pipes use. -->
			<texPath>UI/CSG/IConduit</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom7</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Linked/STB_HotWaterPipe_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<WorkToBuild>280</WorkToBuild>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<Steel>5</Steel>
		</costList>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>STB_HotWaterValve</defName>
		<label>pressurised hot water valve</label>
		<description>Opens or closes a pressurised hot water line, to split stoves between turbines or cut a turbine off.</description>
		<thingClass>PipeSystem.Building_PipeValve</thingClass>
		<category>Building</category>
		<graphicData>
			<texPath>Things/Building/Linked/STB_HotWaterValve</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.5,1.5)</drawSize>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
		</graphicData>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<allowWireConnection>false</allowWireConnection>
		</building>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToBuild>200</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>-2</Beauty>
		</statBases>
		<costList>
			<Steel>15</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_PipeValve">
				<pipeNet>STB_HotWaterNet</pipeNet>
				<alwaysLinkToPipes>true</alwaysLinkToPipes>
			</li>
			<li Class="CompProperties_Flickable">
				<commandTexture>Things/Building/Linked/STB_HotWaterValve</commandTexture>
				<commandLabelKey>STB_ValveLabel</commandLabelKey>
				<commandDescKey>STB_ValveDesc</commandDescKey>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
		</comps>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<tickerType>Normal</tickerType>
		<designationCategory>Power</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		The cobbled steam turbine: one gear step less efficient than the steam turbine, up to 4800W
		of heat, and it breaks down twice as often.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_CobbledTurbine</defName>
		<label>cobbled steam turbine</label>
		<description>A steam turbine pieced together from scrap plate and a salvaged generator, driven by pressurised hot water from trash gasifiers. It takes up to 4800W of heat. Three gears: low turns over on 500W at 50%, medium needs 1500W for 60%, high needs 3000W for 70%. Below its gear's minimum it stalls, wasting the heat. It rattles, and breaks down often. With a turbine on the network, the burners' own Stirling engines stand down. Connect it with a pressurised hot water pipe under it.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_CobbledTurbine</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,4)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<!-- RealTime as well, so CompLooseParts can draw and shake the loose parts every frame. -->
		<drawerType>MapMeshAndRealTime</drawerType>
		<passability>PassThroughOnly</passability>
		<pathCost>150</pathCost>
		<blockWind>true</blockWind>
		<fillPercent>1.0</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<size>(2,3)</size>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToBuild>4000</WorkToBuild>
			<Flammability>0.5</Flammability>
			<Beauty>-25</Beauty>
		</statBases>
		<costList>
			<Steel>200</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="TrashbrickBurning.CompProperties_SteamTurbine">
				<basePowerConsumption>0</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
				<!-- Three cobbled burners on high. -->
				<maxHeatWatts>4800</maxHeatWatts>
				<gears>
					<li><key>Low</key><minWatts>500</minWatts><efficiency>0.5</efficiency></li>
					<li><key>Medium</key><minWatts>1500</minWatts><efficiency>0.6</efficiency></li>
					<li><key>High</key><minWatts>3000</minWatts><efficiency>0.7</efficiency></li>
				</gears>
				<soundAmbientProducingPower>WoodFiredGenerator_Ambience</soundAmbientProducingPower>
			</li>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_HotWaterNet</pipeNet>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
			<!-- The parts that rattle while it turns: two layers drawn over the sprite and shaken. -->
			<li Class="TrashbrickBurning.CompProperties_LooseParts">
				<layers>
					<li><texPath>Things/Building/Power/STB_CobbledTurbine_LooseA</texPath><amplitude>0.012</amplitude><frequency>2.2</frequency><phase>0.4</phase></li>
					<li><texPath>Things/Building/Power/STB_CobbledTurbine_LooseB</texPath><amplitude>0.009</amplitude><frequency>3.1</frequency><phase>2.1</phase></li>
				</layers>
			</li>
			<!-- Springs a steam leak now and then while hot water flows; leaks until repaired. -->
			<li Class="TrashbrickBurning.CompProperties_SteamLeak"/>
			<li Class="TrashbrickBurning.CompProperties_MachineEffects">
				<steam><a>1.0</a><f>1.75</f><z>0.45</z></steam>
				<sound>STB_RattleAmbience</sound>
				<!-- The generator's cooling fan, spinning while it makes power. -->
				<rotor><a>1.0</a><f>2.43</f><z>0.47</z></rotor>
				<rotorSize>0.62</rotorSize>
			</li>
			<li Class="TrashbrickBurning.CompProperties_ExtraBreakdowns"/>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>4</heatPerSecond>
			</li>
		</comps>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		The steam turbine (advanced play mode). Takes up to 6000W of heat from the burners on its
		network - three trash gasifiers on high - in one of three gears. Several turbines on a network
		fill one at a time. No intake: the network connects wherever a pipe runs under it.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_SteamTurbine</defName>
		<label>steam turbine</label>
		<description>A compact steam turbine and generator, driven by pressurised hot water from trash gasifiers. It takes up to 6000W of heat - three gasifiers on high. Three gears: low turns over on 500W at 60%, medium needs 1500W for 70%, high needs 3000W for 80%. Below its gear's minimum it stalls, wasting the heat. With a turbine on the network, the burners' own Stirling engines stand down. Connect it with a pressurised hot water pipe under it.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_SteamTurbine</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<!-- Drawn a margin larger than its 2x3 footprint so raised parts aren't clipped. -->
			<drawSize>(3,4)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<!-- RealTime as well, so the cooling fan can spin every frame. -->
		<drawerType>MapMeshAndRealTime</drawerType>
		<passability>PassThroughOnly</passability>
		<pathCost>150</pathCost>
		<blockWind>true</blockWind>
		<fillPercent>1.0</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<size>(2,3)</size>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<WorkToBuild>6000</WorkToBuild>
			<Flammability>0.3</Flammability>
			<Beauty>-15</Beauty>
		</statBases>
		<costList>
			<Steel>250</Steel>
			<Plasteel>20</Plasteel>
			<ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="TrashbrickBurning.CompProperties_SteamTurbine">
				<basePowerConsumption>0</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
				<!-- Three trash gasifiers on high. -->
				<maxHeatWatts>6000</maxHeatWatts>
				<gears>
					<li><key>Low</key><minWatts>500</minWatts><efficiency>0.6</efficiency></li>
					<li><key>Medium</key><minWatts>1500</minWatts><efficiency>0.7</efficiency></li>
					<li><key>High</key><minWatts>3000</minWatts><efficiency>0.8</efficiency></li>
				</gears>
				<soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
			</li>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_HotWaterNet</pipeNet>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
			<!-- Springs a steam leak now and then while hot water flows; leaks until repaired. -->
			<li Class="TrashbrickBurning.CompProperties_SteamLeak"/>
			<li Class="TrashbrickBurning.CompProperties_MachineEffects">
				<steam><a>1.0</a><f>1.75</f><z>0.5</z></steam>
				<sound>STB_TurbineAmbience</sound>
				<!-- The generator's cooling fan, spinning while it makes power. -->
				<rotor><a>1.0</a><f>2.43</f><z>0.47</z></rotor>
				<rotorSize>0.62</rotorSize>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>2</heatPerSecond>
			</li>
		</comps>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>MicroelectronicsBasics</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		Radiator: heats its room from the network, up to its target temperature, through vanilla's
		own temperature system. Comes after turbines in the network's order. With Dubs Bad Hygiene,
		burners already heat DBH's own radiators through the plumbing; this one needs no DBH.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_HotWaterRadiator</defName>
		<label>hot water radiator</label>
		<description>A cast radiator that heats its room with pressurised hot water from trash gasifiers, up to the temperature you set. Radiators get the heat the steam turbines on their network leave over, then draw on the Overpressure Tank. Connect it by running a pressurised hot water pipe under it.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_HotWaterRadiator</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.5,1.5)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>42</pathCost>
		<fillPercent>0.4</fillPercent>
		<rotatable>false</rotatable>
		<size>(1,1)</size>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>600</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>-4</Beauty>
		</statBases>
		<costList>
			<Steel>45</Steel>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_HotWaterNet</pipeNet>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
			<li Class="TrashbrickBurning.CompProperties_HotWaterRadiator">
				<maxWatts>250</maxWatts>
			</li>
			<li Class="CompProperties_TempControl">
				<!-- Vanilla's, minus the trailing line break it leaves when there's no power comp. -->
				<compClass>TrashbrickBurning.CompRadiatorTempControl</compClass>
				<energyPerSecond>0</energyPerSecond>
			</li>
			<!-- A valve, not a power switch: closed, it takes no heat from the network. -->
			<li Class="CompProperties_Flickable">
				<commandTexture>Things/Building/Linked/STB_HotWaterValve</commandTexture>
				<commandLabelKey>STB_RadiatorValveLabel</commandLabelKey>
				<commandDescKey>STB_RadiatorValveDesc</commandDescKey>
			</li>
			<!-- Springs a steam leak now and then while hot water flows; leaks until repaired. -->
			<li Class="TrashbrickBurning.CompProperties_SteamLeak"/>
		</comps>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Temperature</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>MicroelectronicsBasics</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		The cobbled radiator: the low-tech one. A serpentine of salvaged pipe on timber chocks.
		Cheaper, at Electricity, but only 150W, and it springs leaks about three times as often.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_CobbledRadiator</defName>
		<label>cobbled radiator</label>
		<description>A radiator knocked together from three lengths of salvaged pipe, lashed with wire and propped on timber. It heats its room with pressurised hot water from trash gasifiers, up to the temperature you set - just not much, and its joints weep steam more often than a proper radiator's. Radiators get the heat the steam turbines on their network leave over, then draw on the Overpressure Tank. Connect it by running a pressurised hot water pipe under it.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_CobbledRadiator</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.5,1.5)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>42</pathCost>
		<fillPercent>0.4</fillPercent>
		<rotatable>false</rotatable>
		<size>(1,1)</size>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<WorkToBuild>400</WorkToBuild>
			<Flammability>0.3</Flammability>
			<Beauty>-8</Beauty>
		</statBases>
		<costList>
			<Steel>20</Steel>
			<WoodLog>10</WoodLog>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_HotWaterNet</pipeNet>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
			<li Class="TrashbrickBurning.CompProperties_HotWaterRadiator">
				<maxWatts>150</maxWatts>
			</li>
			<li Class="CompProperties_TempControl">
				<!-- Vanilla's, minus the trailing line break it leaves when there's no power comp. -->
				<compClass>TrashbrickBurning.CompRadiatorTempControl</compClass>
				<energyPerSecond>0</energyPerSecond>
			</li>
			<!-- A valve, not a power switch: closed, it takes no heat from the network. -->
			<li Class="CompProperties_Flickable">
				<commandTexture>Things/Building/Linked/STB_HotWaterValve</commandTexture>
				<commandLabelKey>STB_RadiatorValveLabel</commandLabelKey>
				<commandDescKey>STB_RadiatorValveDesc</commandDescKey>
			</li>
			<!-- Weeps steam about three times as often as a cast radiator. -->
			<li Class="TrashbrickBurning.CompProperties_SteamLeak">
				<mtbDaysPerNetwork>7</mtbDaysPerNetwork>
			</li>
			<!-- Cobbled gear breaks down: a cobbled radiator can too. -->
			<li Class="CompProperties_Breakdownable"/>
			<li Class="TrashbrickBurning.CompProperties_ExtraBreakdowns"/>
		</comps>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Temperature</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		Overpressure Tank (defName kept from the heat accumulator, so saves keep it): takes what
		the turbines and radiators don't use, feeds radiators, and keeps stalling turbines turning.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_HeatAccumulator</defName>
		<label>overpressure tank</label>
		<description>An insulated tank that takes the heat the turbines and radiators don't use, so the burners don't build pressure. It feeds radiators from what it holds, and tops a stalling turbine up to its gear's minimum when the burners fall short - through a breakdown or a refuel. With Dubs Bad Hygiene it also feeds the plumbing's hot water tanks and radiators. The fuller it is, the likelier it is to explode: have a colonist bleed it now and then, or set it to auto-release above a level, which vents the heat into its room.</description>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Power/STB_HeatAccumulator</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
