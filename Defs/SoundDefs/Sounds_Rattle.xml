<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- The jerry-rigged machines' running loop: loose panels, a slipping belt and a knocking
	     bearing over a low hum. Synthesised by Source/Audio/make_rattle.py. -->
	<SoundDef>
		<defName>STB_RattleAmbience</defName>
		<context>MapOnly</context>
		<sustain>true</sustain>
		<maxSimultaneous>3</maxSimultaneous>
		<priorityMode>PrioritizeNearest</priorityMode>
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>STB/CobbledRattle</clipPath>
					</li>
				</grains>
				<volumeRange>14~16</volumeRange>
				<distRange>6~28</distRange>
				<sustainLoop>true</sustainLoop>
			</li>
		</subSounds>
	</SoundDef>

	<!-- The trash gasifier's steam plant: a steady chuff over a firebox rumble. Synthesised by Source/Audio/make_steam.py. -->
	<SoundDef>
		<defName>STB_SteamEngineAmbience</defName>
		<context>MapOnly</context>
		<sustain>true</sustain>
		<maxSimultaneous>3</maxSimultaneous>
		<priorityMode>PrioritizeNearest</priorityMode>
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>STB/SteamEngine</clipPath>
					</li>
				</grains>
				<volumeRange>12~14</volumeRange>
				<distRange>6~28</distRange>
				<sustainLoop>true</sustainLoop>
			</li>
		</subSounds>
	</SoundDef>

	<!-- The steam turbine: shaft hum, blade whine and rushing steam. Synthesised by Source/Audio/make_steam.py. -->
	<SoundDef>
		<defName>STB_TurbineAmbience</defName>
		<context>MapOnly</context>
		<sustain>true</sustain>
		<maxSimultaneous>3</maxSimultaneous>
		<priorityMode>PrioritizeNearest</priorityMode>
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>STB/TurbineWhine</clipPath>
					</li>
				</grains>
				<volumeRange>12~14</volumeRange>
				<distRange>6~28</distRange>
				<sustainLoop>true</sustainLoop>
			</li>
		</subSounds>
	</SoundDef>

</Defs>
